{
  "name": "usaparts-crm",
  "version": "0.3.1",
  "private": true,
  "description": "CRM, automação de marketing e atendimento. Desenvolvido e mantido por Diego Naue Mocelin.",
  "author": "Diego Naue Mocelin",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "node scripts/dev-db.mjs",
    "dev:api": "npm run dev -w @crm/api",
    "dev:web": "npm run dev -w @crm/web",
    "build": "npm run build -w @crm/api && npm run build -w @crm/web",
    "typecheck": "npm run typecheck -w @crm/api && npm run typecheck -w @crm/web",
    "test": "npm run test -w @crm/api",
    "lint": "npm run lint -w @crm/web",
    "release:check": "node scripts/check-release.mjs",
    "smoke": "node scripts/teste-fumaca.mjs"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "argon2": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true,
    "@scarf/scarf": false,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
