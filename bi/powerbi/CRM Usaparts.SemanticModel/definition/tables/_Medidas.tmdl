	measure 'Valor em brindes (mês anterior)' = CALCULATE ( [Valor em brindes], DATEADD ( Calendario[Data], -1, MONTH ) )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Brindes\Comparações

	measure 'Valor em brindes vs. mês anterior (%)' =
			VAR Atual = [Valor em brindes]
			VAR Anterior = [Valor em brindes (mês anterior)]
			RETURN
			    IF ( NOT ISBLANK ( Anterior ), DIVIDE ( Atual - Anterior, Anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Brindes\Comparações

	measure 'Taxa de conversão (ano anterior)' = CALCULATE ( [Taxa de conversão], SAMEPERIODLASTYEAR ( Calendario[Data] ) )
		formatString: 0.0%
		displayFolder: Comercial\Comparações

	/// Diferença em pontos percentuais.
	measure 'Taxa de conversão vs. ano anterior (p.p.)' = [Taxa de conversão] - [Taxa de conversão (ano anterior)]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comercial\Comparações

	/// Valor escolhido em "Variação da taxa de conversão (%)" (sem escolha: 0%).
	measure 'Cenário: variação da conversão' = SELECTEDVALUE ( 'Variação da taxa de conversão (%)'[Variação da taxa de conversão (%)], 0 ) / 100
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Cenários\Parâmetros

	/// Valor escolhido em "Variação do investimento em anúncios (%)" (sem escolha: 0%).
	measure 'Cenário: variação do investimento' = SELECTEDVALUE ( 'Variação do investimento em anúncios (%)'[Variação do investimento em anúncios (%)], 0 ) / 100
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Cenários\Parâmetros

	/// Valor escolhido em "Variação do ticket médio (%)" (sem escolha: 0%).
	measure 'Cenário: variação do ticket médio' = SELECTEDVALUE ( 'Variação do ticket médio (%)'[Variação do ticket médio (%)], 0 ) / 100
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Cenários\Parâmetros

	/// Valor escolhido em "Variação do frete (%)" (sem escolha: 0%).
	measure 'Cenário: variação do frete' = SELECTEDVALUE ( 'Variação do frete (%)'[Variação do frete (%)], 0 ) / 100
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Cenários\Parâmetros

	/// Hipótese: as pré-vendas que vieram do Google Ads crescem na mesma proporção do investimento.
	measure 'Pré-vendas projetadas' = [Pré-vendas] + [Leads Google Ads] * [Cenário: variação do investimento]
		formatString: #,0
		displayFolder: Cenários

	measure 'Taxa de conversão projetada' = MIN ( [Taxa de conversão] * ( 1 + [Cenário: variação da conversão] ), 1 )
		formatString: 0.0%
		displayFolder: Cenários

	measure 'Vendas projetadas' = [Pré-vendas projetadas] * [Taxa de conversão projetada]
		formatString: #,0.0
		displayFolder: Cenários

	measure 'Ticket médio projetado' = [Ticket médio] * ( 1 + [Cenário: variação do ticket médio] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Cenários

	/// Receita das pré-vendas no cenário (pré-vendas × conversão × ticket).
	measure 'Receita projetada' = [Vendas projetadas] * [Ticket médio projetado]
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Cenários

	measure 'Diferença de vendas' = [Vendas projetadas] - [Vendas]
		formatString: +#,0.0;-#,0.0;0
		displayFolder: Cenários

	measure 'Diferença de receita' = [Receita projetada] - [Receita das pré-vendas]
		formatString: +\R$ #,0.00;-\R$ #,0.00;\R$ 0.00
		displayFolder: Cenários

	measure 'Diferença de receita (%)' = DIVIDE ( [Diferença de receita], [Receita das pré-vendas] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Cenários

	measure 'Investimento projetado' = [Investimento nas plataformas] * ( 1 + [Cenário: variação do investimento] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Cenários

	measure 'Investimento Google projetado' = [Investimento Google] * ( 1 + [Cenário: variação do investimento] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Cenários

	measure 'Receita Google Ads projetada' = [Receita Google Ads] * ( 1 + [Cenário: variação do investimento] ) * ( 1 + [Cenário: variação da conversão] ) * ( 1 + [Cenário: variação do ticket médio] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Cenários

	/// ROAS do Google Ads no cenário.
	measure 'ROAS projetado' = DIVIDE ( [Receita Google Ads projetada], [Investimento Google projetado] )
		formatString: #,0.00
		displayFolder: Cenários

	measure 'Diferença de ROAS' = [ROAS projetado] - [ROAS Google]
		formatString: +#,0.00;-#,0.00;0.00
		displayFolder: Cenários

	measure 'Frete projetado' = [Frete pago (CT-e)] * ( 1 + [Cenário: variação do frete] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Cenários

	measure 'Diferença de frete' = [Frete projetado] - [Frete pago (CT-e)]
		formatString: +\R$ #,0.00;-\R$ #,0.00;\R$ 0.00
		displayFolder: Cenários

	measure 'Frete sobre a venda projetado' = DIVIDE ( [Frete projetado], [Receita projetada] + [Receita da loja] * ( 1 + [Cenário: variação do ticket médio] ) )
		formatString: 0.0%
		displayFolder: Cenários

	measure 'Diferença do frete sobre a venda (p.p.)' = [Frete sobre a venda projetado] - [Frete sobre a venda]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Cenários

	column Coluna
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Coluna]

	partition _Medidas = calculated
		mode: import
		source =
			ROW ( "Coluna", 0 )
