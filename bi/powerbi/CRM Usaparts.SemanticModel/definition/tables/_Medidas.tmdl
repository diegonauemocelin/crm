		displayFolder: Marketing\Comparações

	measure 'Frete pago (CT-e) (ano anterior)' = CALCULATE ( [Frete pago (CT-e)], SAMEPERIODLASTYEAR ( Calendario[Data] ) )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Fretes\Comparações

	measure 'Frete pago (CT-e) vs. ano anterior (%)' =
			VAR Atual = [Frete pago (CT-e)]
			VAR Anterior = [Frete pago (CT-e) (ano anterior)]
			RETURN
			    IF ( NOT ISBLANK ( Anterior ), DIVIDE ( Atual - Anterior, Anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Fretes\Comparações

	measure 'Frete pago (CT-e) (mês anterior)' = CALCULATE ( [Frete pago (CT-e)], DATEADD ( Calendario[Data], -1, MONTH ) )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Fretes\Comparações

	measure 'Frete pago (CT-e) vs. mês anterior (%)' =
			VAR Atual = [Frete pago (CT-e)]
			VAR Anterior = [Frete pago (CT-e) (mês anterior)]
			RETURN
			    IF ( NOT ISBLANK ( Anterior ), DIVIDE ( Atual - Anterior, Anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Fretes\Comparações

	measure 'Valor em brindes (ano anterior)' = CALCULATE ( [Valor em brindes], SAMEPERIODLASTYEAR ( Calendario[Data] ) )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Brindes\Comparações

	measure 'Valor em brindes vs. ano anterior (%)' =
			VAR Atual = [Valor em brindes]
			VAR Anterior = [Valor em brindes (ano anterior)]
			RETURN
			    IF ( NOT ISBLANK ( Anterior ), DIVIDE ( Atual - Anterior, Anterior ) )
