	measure 'Investimento nas plataformas (ano anterior)' = CALCULATE ( [Investimento nas plataformas], SAMEPERIODLASTYEAR ( Calendario[Data] ) )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Marketing\Comparações

	measure 'Investimento nas plataformas vs. ano anterior (%)' =
			VAR Atual = [Investimento nas plataformas]
			VAR Anterior = [Investimento nas plataformas (ano anterior)]
			RETURN
			    IF ( NOT ISBLANK ( Anterior ), DIVIDE ( Atual - Anterior, Anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Marketing\Comparações

	measure 'Investimento nas plataformas (mês anterior)' = CALCULATE ( [Investimento nas plataformas], DATEADD ( Calendario[Data], -1, MONTH ) )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Marketing\Comparações

