/// Calendário (dias de 5 anos atrás até o fim do ano atual). Marcado como tabela de datas.
table Calendario
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: [Data]

		annotation UnderlyingDateTimeDataType = Date

	column Ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Ano]

	column Trimestre
		dataType: string
		summarizeBy: none
		sourceColumn: [Trimestre]
		sortByColumn: 'Trimestre nº'

	column 'Trimestre nº'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Trimestre nº]

	column 'Mês nº'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Mês nº]

	column 'Mês'
		dataType: string
		summarizeBy: none
		sourceColumn: [Mês]
		sortByColumn: 'Mês nº'

	column 'Mês/Ano'
		dataType: string
		summarizeBy: none
		sourceColumn: [Mês/Ano]
		sortByColumn: 'Ano-Mês nº'

	column 'Ano-Mês nº'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Ano-Mês nº]

	/// Semana ISO do ano.
	column Semana
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Semana]

	column Dia
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Dia]

	column 'Dia da semana'
		dataType: string
		summarizeBy: none
		sourceColumn: [Dia da semana]
		sortByColumn: 'Dia da semana nº'

	column 'Dia da semana nº'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Dia da semana nº]

	hierarchy 'Calendário'

		level Ano
			column: Ano

		level Trimestre
			column: Trimestre

		level 'Mês'
			column: 'Mês'

		level Dia
			column: Dia

	partition Calendario = calculated
		mode: import
		source =
			VAR Datas =
			    CALENDAR ( DATE ( YEAR ( TODAY () ) - 5, 1, 1 ), DATE ( YEAR ( TODAY () ), 12, 31 ) )
			RETURN
			    ADDCOLUMNS (
			        SELECTCOLUMNS ( Datas, "Data", [Date] ),
			        "Ano", YEAR ( [Data] ),
			        "Trimestre", "T" & QUARTER ( [Data] ),
			        "Trimestre nº", QUARTER ( [Data] ),
			        "Mês nº", MONTH ( [Data] ),
			        "Mês", SWITCH ( MONTH ( [Data] ), 1, "janeiro", 2, "fevereiro", 3, "março", 4, "abril", 5, "maio", 6, "junho", 7, "julho", 8, "agosto", 9, "setembro", 10, "outubro", 11, "novembro", 12, "dezembro" ),
			        "Mês/Ano", SWITCH ( MONTH ( [Data] ), 1, "jan", 2, "fev", 3, "mar", 4, "abr", 5, "mai", 6, "jun", 7, "jul", 8, "ago", 9, "set", 10, "out", 11, "nov", 12, "dez" ) & "/" & RIGHT ( YEAR ( [Data] ), 2 ),
			        "Ano-Mês nº", YEAR ( [Data] ) * 100 + MONTH ( [Data] ),
			        "Semana", WEEKNUM ( [Data], 21 ),
			        "Dia", DAY ( [Data] ),
			        "Dia da semana", SWITCH ( WEEKDAY ( [Data], 2 ), 1, "segunda-feira", 2, "terça-feira", 3, "quarta-feira", 4, "quinta-feira", 5, "sexta-feira", 6, "sábado", 7, "domingo" ),
			        "Dia da semana nº", WEEKDAY ( [Data], 2 )
			    )
