/// Vendas do Mercado Livre ligadas a uma pergunta respondida (Assistente ML), sem o comprador.
table fato_ml_vendas

	/// Número interno.
	column venda_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: venda_id

	/// Pergunta que levou à venda (fato_ml_perguntas).
	column pergunta_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: pergunta_id

	/// Número do pedido no Mercado Livre.
	column pedido_ml
		dataType: string
		summarizeBy: none
		sourceColumn: pedido_ml

	/// Anúncio vendido.
	column anuncio_ml_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: anuncio_ml_id

	/// Título do anúncio.
	column titulo_anuncio
		dataType: string
		summarizeBy: none
		sourceColumn: titulo_anuncio

	/// Data e hora do pedido.
	column pedido_em
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		summarizeBy: none
		sourceColumn: pedido_em

	/// Dia do pedido.
	column data_pedido
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: data_pedido

		annotation UnderlyingDateTimeDataType = Date

	/// Situação do pedido no Mercado Livre.
	column situacao_pedido
		dataType: string
		summarizeBy: none
		sourceColumn: situacao_pedido

	/// Situação do pagamento.
	column situacao_pagamento
		dataType: string
		summarizeBy: none
		sourceColumn: situacao_pagamento

	/// Quantidade.
	column quantidade
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: quantidade

	/// Preço unitário.
	column preco_unitario
		dataType: decimal
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		summarizeBy: sum
		sourceColumn: preco_unitario

	/// Total.
	column total
		dataType: decimal
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		summarizeBy: sum
		sourceColumn: total

	/// Moeda (BRL).
	column moeda
		dataType: string
		summarizeBy: none
		sourceColumn: moeda

	/// mesmo_anuncio ou anuncio_indicado.
	column tipo_vinculo
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_vinculo

	/// Horas entre a pergunta e o pedido.
	column horas_apos_pergunta
		dataType: double
		formatString: #,0.0
		summarizeBy: average
		sourceColumn: horas_apos_pergunta

	/// Pedido pago antes da pergunta (não conta como venda do assistente).
	column pago_antes
		dataType: boolean
		summarizeBy: none
		sourceColumn: pago_antes

	partition fato_ml_vendas = m
		mode: import
		source =
			let
			    Fonte = CRM_Tabela("fato_ml_vendas"),
			    Tipada = Table.TransformColumnTypes(Fonte, {{"venda_id", Int64.Type}, {"pergunta_id", Int64.Type}, {"pedido_ml", type text}, {"anuncio_ml_id", type text}, {"titulo_anuncio", type text}, {"pedido_em", type datetime}, {"data_pedido", type date}, {"situacao_pedido", type text}, {"situacao_pagamento", type text}, {"quantidade", Int64.Type}, {"preco_unitario", Currency.Type}, {"total", Currency.Type}, {"moeda", type text}, {"tipo_vinculo", type text}, {"horas_apos_pergunta", type number}, {"pago_antes", type logical}})
			in
			    Tipada
