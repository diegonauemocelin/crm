/// Produtos dos pedidos da loja virtual (lidos do detalhe do pedido).
table fato_itens_pedido

	/// Número interno (uuid).
	column item_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: item_id

	/// Pedido (fato_pedidos_loja).
	column pedido_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: pedido_id

	/// Dia do pedido.
	column data_pedido
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: data_pedido

		annotation UnderlyingDateTimeDataType = Date

	/// Situação do pedido: pago, pendente ou cancelado.
	column grupo_situacao
		dataType: string
		summarizeBy: none
		sourceColumn: grupo_situacao

	/// Canal de venda do pedido.
	column canal
		dataType: string
		summarizeBy: none
		sourceColumn: canal

	/// Código (SKU) da derivação.
	column sku
		dataType: string
		summarizeBy: none
		sourceColumn: sku

	/// Produto do catálogo com o mesmo SKU (dim_produto).
	column produto_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: produto_id

	/// Nome do produto no pedido.
	column nome
		dataType: string
		summarizeBy: none
		sourceColumn: nome

	/// Marca.
	column marca
		dataType: string
		summarizeBy: none
		sourceColumn: marca

	/// Quantidade.
	column quantidade
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: quantidade

	/// Valor total do item, já com desconto (R$).
	column total
		dataType: decimal
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		summarizeBy: sum
		sourceColumn: total

	partition fato_itens_pedido = m
		mode: import
		source =
			let
			    Fonte = CRM_Tabela("fato_itens_pedido"),
			    Tipada = Table.TransformColumnTypes(Fonte, {{"item_id", type text}, {"pedido_id", type text}, {"data_pedido", type date}, {"grupo_situacao", type text}, {"canal", type text}, {"sku", type text}, {"produto_id", type text}, {"nome", type text}, {"marca", type text}, {"quantidade", Int64.Type}, {"total", Currency.Type}})
			in
			    Tipada
