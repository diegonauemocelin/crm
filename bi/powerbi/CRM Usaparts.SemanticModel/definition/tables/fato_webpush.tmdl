/// Campanhas de Web Push da loja virtual: disparos, entregas e cliques.
table fato_webpush

	/// Número interno (uuid).
	column campanha_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: campanha_id

	/// Nome interno.
	column nome
		dataType: string
		summarizeBy: none
		sourceColumn: nome

	/// Título da notificação.
	column titulo
		dataType: string
		summarizeBy: none
		sourceColumn: titulo

	/// RASCUNHO, AGENDADO, ENVIANDO, ENVIADO, CANCELADO ou ERRO.
	column situacao
		dataType: string
		summarizeBy: none
		sourceColumn: situacao

	/// Agendamento.
	column agendado_em
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		summarizeBy: none
		sourceColumn: agendado_em

	/// Início do envio.
	column enviado_em
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		summarizeBy: none
		sourceColumn: enviado_em

	/// Fim do envio.
	column finalizado_em
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		summarizeBy: none
		sourceColumn: finalizado_em

	/// Dia do envio (ou da criação).
	column data_envio
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: data_envio

		annotation UnderlyingDateTimeDataType = Date

	/// Inscritos alcançados.
	column alvos
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: alvos

	/// Enviados.
	column enviados
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: enviados

	/// Falhas.
	column falhas
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: falhas

	/// Mostrados no aparelho.
	column entregues
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: entregues

	/// Cliques.
	column cliques
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: cliques

	/// Criação.
	column criado_em
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		summarizeBy: none
		sourceColumn: criado_em

	/// Última alteração.
	column atualizado_em
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		summarizeBy: none
		sourceColumn: atualizado_em

	partition fato_webpush = m
		mode: import
		source =
			let
			    Fonte = CRM_Tabela("fato_webpush"),
			    Tipada = Table.TransformColumnTypes(Fonte, {{"campanha_id", type text}, {"nome", type text}, {"titulo", type text}, {"situacao", type text}, {"agendado_em", type datetime}, {"enviado_em", type datetime}, {"finalizado_em", type datetime}, {"data_envio", type date}, {"alvos", Int64.Type}, {"enviados", Int64.Type}, {"falhas", Int64.Type}, {"entregues", Int64.Type}, {"cliques", Int64.Type}, {"criado_em", type datetime}, {"atualizado_em", type datetime}})
			in
			    Tipada
