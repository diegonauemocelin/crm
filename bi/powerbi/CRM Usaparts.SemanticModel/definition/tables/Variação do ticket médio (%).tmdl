/// Parâmetro de cenário (what-if): de -30% a 50%, de 5 em 5. Use no controle deslizante da página Cenários.
table 'Variação do ticket médio (%)'

	column 'Variação do ticket médio (%)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Variação do ticket médio (%)' = calculated
		mode: import
		source =
			GENERATESERIES ( -30, 50, 5 )
