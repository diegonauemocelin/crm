/// Brindes cadastrados no Controle de brindes.
table dim_brinde

	/// Número interno (uuid).
	column brinde_id
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: brinde_id

	/// Nome do brinde.
	column nome
		dataType: string
		summarizeBy: none
		sourceColumn: nome

	/// Valor unitário atual (R$).
	column custo_unitario
		dataType: decimal
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		summarizeBy: sum
		sourceColumn: custo_unitario

	/// Estoque atual.
	column estoque
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: estoque

	/// Ativo.
	column ativo
		dataType: boolean
		summarizeBy: none
		sourceColumn: ativo

	partition dim_brinde = m
		mode: import
		source =
			let
			    Fonte = CRM_Tabela("dim_brinde"),
			    Tipada = Table.TransformColumnTypes(Fonte, {{"brinde_id", type text}, {"nome", type text}, {"custo_unitario", Currency.Type}, {"estoque", Int64.Type}, {"ativo", type logical}})
			in
			    Tipada
