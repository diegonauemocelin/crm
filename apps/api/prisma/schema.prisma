}

// ---------- Assistente de perguntas do Mercado Livre (veio do painel.usaparts.com.br) ----------
// Os ids são números, como no painel: a IA cita os conhecimentos pelo número e as telas mostram "#123".

/// Pergunta recebida no marketplace: registro único por pergunta, com a trajetória em assist_events.
model AssistQuestion {
  id                  Int       @id @default(autoincrement())
  tenantId            String    @db.Uuid
  marketplace         String    @default("mercadolivre")
  mlQuestionId        String
  mlItemId            String?
  mlStatus            String?
  customerId          String?
  customerNickname    String?
  customerName        String?
  customerLookupAt    DateTime?
  text                String
  receivedAt          DateTime
  firstSeenAt         DateTime
  /// nova, aguardando_analise, em_atendimento, aguardando_cliente, aguardando_validacao, conhecimento_aprovacao, respondida, resolvida, nao_aplicavel
  status              String    @default("nova")
  processingState     String    @default("ocioso")
  processingStartedAt DateTime?
  /// A a G (motivo da pendência)
  pendingReason       String?
  pendingSince        DateTime?
  brand               String?
  model               String?
  partCode            String?
  purchaseIntent      Boolean   @default(false)
  relevance           Int       @default(0)
  assignedToId        String?   @db.Uuid
  assignedToName      String?
  confidence          Float?
  answeredAt          DateTime?
  resolvedAt          DateTime?
  externalAnsweredAt  DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([tenantId, mlQuestionId])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
  @@index([tenantId, customerId])
  @@map("assist_questions")
}

/// Cada resposta preparada ou enviada (nunca sobrescrita).
model AssistAttempt {
  id               Int       @id @default(autoincrement())
  tenantId         String    @db.Uuid
  questionId       Int
  /// ia ou atendente
  origin           String
  /// resposta ou solicitar_info
  kind             String    @default("resposta")
  authorId         String?   @db.Uuid
  authorName       String?
  basedOnId        Int?
  text             String
  ai               Json?
  confidence       Float?
  /// preparada, pendente_aprovacao, enviando, enviada, pendente_confirmacao, falha, descartada
  sendStatus       String
  createdAt        DateTime  @default(now())
  sendRequestedAt  DateTime?
  sentAt           DateTime?
  confirmedAt      DateTime?
  mlResponse       Json?
  mlAnswerRef      String?
  error            String?
  sendAttempts     Int       @default(0)
  reviewed         Boolean   @default(false)
  reviewedById     String?   @db.Uuid
  reviewedByName   String?
  flaggedForReview Boolean   @default(false)

  @@index([tenantId, questionId])
  @@index([tenantId, sendStatus])
  @@map("assist_attempts")
}

/// Conhecimentos (com a versão) usados em cada resposta.
model AssistAttemptKnowledge {
  attemptId        Int
  knowledgeId      Int
  knowledgeVersion Int

  @@id([attemptId, knowledgeId])
  @@index([knowledgeId])
  @@map("assist_attempt_knowledge")
}

/// Observação interna de uma pergunta ou de uma resposta.
model AssistNote {
  id        Int      @id @default(autoincrement())
  tenantId  String   @db.Uuid
  /// question ou answer
  entity    String
  entityId  Int
  userId    String?  @db.Uuid
  userName  String
  note      String
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("assist_notes")
}

/// Trajetória de cada pergunta.
model AssistEvent {
  id         Int      @id @default(autoincrement())
  tenantId   String   @db.Uuid
  questionId Int
  type       String
  fromStatus String?
  toStatus   String?
  userId     String?  @db.Uuid
  userName   String?
  note       String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([questionId])
  @@index([tenantId, type, createdAt])
  @@map("assist_events")
}

/// Base de conhecimento (técnico e comercial) que a IA pode usar.
model AssistKnowledge {
  id               Int       @id @default(autoincrement())
  tenantId         String    @db.Uuid
  title            String
  category         String
  brand            String?
  model            String?
  partCode         String?
  product          String?
  application      String?
  question         String?
  answer           String
  source           String?
  /// ativo, em_revisao, inativo, rascunho
  status           String    @default("em_revisao")
  version          Int       @default(1)
  originQuestionId Int?
  originImportId   Int?
  createdById      String?   @db.Uuid
  createdByName    String?
  updatedById      String?   @db.Uuid
  updatedByName    String?
  approvedById     String?   @db.Uuid
  approvedByName   String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  deletedAt        DateTime?
  deletedByName    String?
  matchKey         String?
  autoLearned      Boolean   @default(false)
  /// conhecimento que vale só para um anúncio
  mlItemId         String?
  /// manual, aprovada, externa ou ia
  learnedFrom      String?

  @@index([tenantId, status])
  @@index([tenantId, matchKey])
  @@index([tenantId, partCode])
  @@map("assist_knowledge")
}

model AssistKnowledgeVersion {
  id            Int      @id @default(autoincrement())
  tenantId      String   @db.Uuid
  knowledgeId   Int
  version       Int
  snapshot      Json
  changeType    String
  changedById   String?  @db.Uuid
  changedByName String?
  changedAt     DateTime @default(now())

  @@index([knowledgeId])
  @@map("assist_knowledge_versions")
}

/// Importação de planilha Excel para a base de conhecimento (prévia, correções e confirmação).
model AssistImport {
  id           Int       @id @default(autoincrement())
  tenantId     String    @db.Uuid
  filename     String
  userId       String?   @db.Uuid
  userName     String?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// previa, confirmada, cancelada, invalida
  status       String    @default("previa")
  totalRows    Int       @default(0)
  imported     Int       @default(0)
  updated      Int       @default(0)
  ignored      Int       @default(0)
  errors       Int       @default(0)
  headerErrors Json?
  report       Json?

  @@index([tenantId, createdAt])
  @@map("assist_imports")
}

model AssistImportRow {
  id         Int     @id @default(autoincrement())
  importId   Int
  rowNumber  Int
  data       Json
  /// novo, atualizacao, identico, duplicado, erro
  action     String
  existingId Int?
  existing   Json?
  errors     Json?
  warnings   Json?
  /// pendente, aceitar, rejeitar
  decision   String  @default("pendente")
  result     String?

  @@index([importId])
  @@map("assist_import_rows")
}

/// Anúncios da loja no Mercado Livre (cópia local sincronizada pela API).
model AssistItem {
  tenantId          String   @db.Uuid
  id                String
  sellerId          String?
  officialStoreId   String?
  title             String?
  permalink         String?
  price             Decimal? @db.Decimal(14, 2)
  currency          String?
  availableQuantity Int?
  status            String?
  sellerSku         String?
  partNumber        String?
  brand             String?
  description       String?
  attributes        Json?
  mlLastUpdated     String?
  syncedAt          DateTime

  @@id([tenantId, id])
  @@index([tenantId, status])
  @@map("assist_items")
}

/// Aplicação peça × máquina (compatibilidade confirmada, pendente ou não confirmada).
model AssistApplication {
  id               Int       @id @default(autoincrement())
  tenantId         String    @db.Uuid
  partCode         String
  productName      String?
  partBrand        String?
  machineBrand     String?
  machineModel     String?
  system           String?
  application      String?
  mlItemId         String?
  /// confirmada, pendente, nao_confirmada
  validationStatus String    @default("pendente")
  knowledgeId      Int?
  source           String?
  validatedById    String?   @db.Uuid
  validatedByName  String?
  validatedAt      DateTime?
  createdById      String?   @db.Uuid
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  matchKey         String

  @@unique([tenantId, matchKey])
  @@index([tenantId, partCode])
  @@index([tenantId, machineModel])
  @@map("assist_applications")
}

/// Venda (ou ida ao checkout) do mesmo comprador ligada a uma pergunta.
model AssistSale {
  id                 Int      @id @default(autoincrement())
  tenantId           String   @db.Uuid
  mlOrderId          String
  mlItemId           String
  itemTitle          String?
  questionId         Int
  buyerId            String
  orderStatus        String?
  orderDate          DateTime
  quantity           Int      @default(1)
  unitPrice          Decimal? @db.Decimal(14, 2)
  total              Decimal? @db.Decimal(14, 2)
  currency           String?
  /// mesmo_anuncio ou anuncio_indicado
  matchType          String
  hoursAfterQuestion Float?
  linkedAt           DateTime @default(now())
  updatedAt          DateTime @default(now())
  paidBefore         Boolean  @default(false)
  paymentStatus      String?

  @@unique([tenantId, mlOrderId, mlItemId])
  @@index([tenantId, questionId])
  @@index([tenantId, orderDate])
  @@map("assist_sales")
}

/// Landing page (E-mail marketing › Landing pages): blocos, tema, versão B para teste A/B e publicação no subdomínio.
model LandingPage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  /// Endereço da página no subdomínio (ex.: filtros-komatsu).
  slug        String
  /// RASCUNHO, PUBLICADA ou PAUSADA.
  status      String    @default("RASCUNHO")
  /// Cores, fonte, cantos e botões da página.
  theme       Json
  /// Blocos da versão A (e única, sem teste A/B).
  blocks      Json
  /// Blocos da versão B (teste A/B); vazio = sem teste.
  blocksB     Json?
  /// Parte das visitas que vê a versão B (0 a 100).
  abSplit     Int       @default(50)
  abActive    Boolean   @default(false)
  /// Título e descrição para o Google e as redes, imagem de compartilhamento e "não aparecer no Google".
  seo         Json
  publishedAt DateTime?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  events LandingEvent[]

  @@unique([tenantId, slug])
  @@map("landing_pages")
}

/// Visita, rolagem, clique no botão, clique no WhatsApp e lead de uma landing page (por versão A/B e origem).
model LandingEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  pageId     String   @db.Uuid
  variant    String   @default("A")
  /// view, scroll, cta, whatsapp ou lead.
  type       String
  /// Identificador aleatório do navegador (sem dado pessoal).
  visitor    String
  source     String?
  medium     String?
  campaign   String?
  device     String?
  leadId     String?  @db.Uuid
  occurredAt DateTime @default(now())

  page LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("landing_events")
}

/// SEO do e-commerce: textos de SEO de cada produto da Magazord (aba SEO e Descrição Geral), com a nota e os problemas.
model SeoProduct {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  /// Código do produto pai na Magazord.
  productCode    String
  /// Derivação usada para ler o produto e as outras derivações dele.
  derivationCode String
  derivations    String[]  @default([])
  name           String
  brand          String?
  categories     String[]  @default([])
  /// Características cadastradas (nome e valor), base para a IA.
  attributes     Json
  ean            String?
  image          String?
  /// Página do produto na Magazord (aba SEO).
  pageId         Int?
  /// Textos atuais (título SEO, meta-description, URL, título, subtítulo, descrição, resumo).
  fields         Json
  score          Int
  issues         Json
  checkedAt      DateTime
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  changes SeoChange[]

  @@unique([tenantId, productCode])
  @@index([tenantId, score])
  @@map("seo_products")
}

/// Alteração de SEO de um produto: sugestão (IA ou manual), revisão, envio para a Magazord e volta atrás.
model SeoChange {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  seoProductId  String    @db.Uuid
  /// Textos antes da alteração (para desfazer).
  before        Json
  /// Textos propostos (todos os campos sugeridos).
  proposed      Json
  /// Campos escolhidos para enviar.
  sendFields    String[]  @default([])
  /// SUGERIDA, ENVIADA, ERRO, DESCARTADA ou DESFEITA.
  status        String    @default("SUGERIDA")
  /// ia ou manual.
  source        String    @default("ia")
  error         String?
  createdById   String?   @db.Uuid
  createdByName String?
  sentByName    String?
  sentAt        DateTime?
  undoneAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product SeoProduct @relation(fields: [seoProductId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([seoProductId])
  @@map("seo_changes")
}

/// Figurinhas salvas por cada atendente (recebidas no chat ou enviadas do computador), para mandar nas conversas.
model WhatsappSticker {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  /// Imagem guardada no CRM (FileAsset, tipo "figurinha").
  fileId    String   @db.Uuid
  /// SHA-256 da imagem: a mesma figurinha não entra duas vezes para a mesma pessoa.
  hash      String
  mime      String
  createdAt DateTime @default(now())

  @@unique([userId, hash])
  @@index([tenantId, userId, createdAt])
  @@map("whatsapp_stickers")
}

/// Biblioteca de mídias das postagens: fotos (JPEG) e vídeos (MP4) próprios, artes montadas no CRM e imagens da IA.
model SocialMedia {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  /// Arquivo guardado no CRM (FileAsset, tipo "postagem").
  fileId        String   @db.Uuid
  /// imagem ou video
  kind          String
  mime          String
  name          String
  /// upload, arte, catalogo, ia ou video (montado a partir de fotos)
  source        String   @default("upload")
  width         Int?
  height        Int?
  size          Int      @default(0)
  createdById   String?  @db.Uuid
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("social_media")
}

/// Postagens planejadas no Instagram e no Facebook: rascunho → aprovação → agendada → publicada.
model SocialPost {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  title          String
  caption        String    @default("")
  /// Contas escolhidas (ids da lista de contas de Postagens): uma, várias ou todas.
  accountIds     String[]  @default([])
  /// Redes dessas contas (instagram, facebook), para os ícones e as regras de formato.
  networks       String[]  @default([])
  /// FEED, STORIES ou REELS
  format         String    @default("FEED")
  /// Mídias da biblioteca (SocialMedia), na ordem do carrossel.
  mediaIds       String[]  @default([])
  /// Quando publicar; vazio = assim que for aprovada.
  scheduledAt    DateTime?
  /// RASCUNHO, EM_APROVACAO, APROVADO, PUBLICANDO, PUBLICADO ou ERRO
  status         String    @default("RASCUNHO")
  /// Endereço público das mídias para a Meta baixar (difícil de adivinhar; só vale até publicar).
  publicToken    String
  /// Por rede: { id, permalink, at } ou { error }.
  results        Json?
  error          String?
  /// Motivo de a aprovação ter devolvido a postagem.
  reviewNote     String?
  createdById    String?   @db.Uuid
  createdByName  String?
  updatedByName  String?
  submittedAt    DateTime?
  approvedById   String?   @db.Uuid
  approvedByName String?
  approvedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("social_posts")
}
