// Modelo de dados do CRM. Toda tabela de negócio carrega tenantId para permitir a evolução para SaaS.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum LayoutMode {
  CLASSIC
  MODERN
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum PermissionScope {
  OWN
  UNIT
  ALL
}

enum ServiceKind {
  PRE_VENDAS
  POS_VENDAS
}

enum ReturnStatus {
  SIM
  NAO
  PENDENTE
}

enum SaleStatus {
  SIM
  NAO
  NEGOCIACAO
}

/// Acompanhamento do pós-venda gerado automaticamente a partir da pré-venda.
enum FollowStatus {
  PENDENTE
  CONTATADO
  ANALISANDO
  RESOLVIDO
  VOLTOU_AO_VENDEDOR
}

/// Listas configuráveis dos atendimentos. Itens são desativados, nunca apagados, para preservar o histórico.
enum LookupType {
  ORIGEM
  TIPO_CLIENTE
  MARCA
  TIPO_PECA
  MOTIVO_PERDA
}

/// Funil de marketing. "Visitante" (anônimo) fica no rastreamento do site; aqui estão as pessoas identificadas.
enum LeadStage {
  LEAD
  QUALIFICADO
  OPORTUNIDADE
  CLIENTE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

enum ScoreDimension {
  PERFIL
  INTERESSE
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users          User[]
  roles          Role[]
  settings       TenantSetting[]
  files          FileAsset[]
  units          Unit[]
  sellers        Seller[]
  lookups        LookupItem[]
  serviceRecords ServiceRecord[]
  leads          Lead[]
  customFields   CustomFieldDef[]
  scoreRules     ScoreRule[]
  leadImports    LeadImport[]
  siteVisitors   SiteVisitor[]
  receipts       IntegrationReceipt[]
  carts          EcommerceCart[]
  orders         EcommerceOrder[]
  forms          CaptureForm[]
  popups         CapturePopup[]
  whatsapps      CaptureWhatsapp[]
  segments       EmailSegment[]
  campaigns      EmailCampaign[]

  @@map("tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  /// Perfil de sistema (Administrador): não pode ser editado nem excluído e tem acesso total.
  isSystem    Boolean  @default(false)
  require2fa  Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  id        String          @id @default(uuid()) @db.Uuid
  roleId    String          @db.Uuid
  module    String
  canView   Boolean         @default(false)
  canCreate Boolean         @default(false)
  canEdit   Boolean         @default(false)
  canDelete Boolean         @default(false)
  canExport Boolean         @default(false)
  scope     PermissionScope @default(ALL)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  roleId             String     @db.Uuid
  name               String
  email              String
  passwordHash       String
  avatarFileId       String?    @db.Uuid
  active             Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime   @default(now())

  /// Segredo TOTP criptografado (AES-256-GCM). O "pending" existe só durante a configuração.
  totpSecretEnc        String?
  totpPendingSecretEnc String?
  totpEnabled          Boolean  @default(false)
  /// Último time step TOTP aceito; impede reutilizar o mesmo código.
  totpLastStep         Int?

  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  lastLoginIp  String?

  layout LayoutMode?
  theme  ThemeMode   @default(SYSTEM)

  /// Unidade do usuário: base do escopo "somente da sua unidade" nos perfis de acesso.
  unitId String? @db.Uuid
  unit   Unit?   @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  role           Role                 @relation(fields: [roleId], references: [id])
  seller         Seller?
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  recoveryCodes  RecoveryCode[]

  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// Todos os tokens de uma mesma sessão compartilham a família. Reuso de token revogado derruba a família inteira.
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model RecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Log de auditoria encadeado por hash. UPDATE e DELETE são bloqueados por trigger no banco.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  userEmail String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  data      Json?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model FileAsset {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  kind      String
  mime      String
  size      Int
  path      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("file_assets")
}

/// Histórico de versões exibido na tela "Atualizações". Sincronizado a partir de releases.json a cada inicialização.
model SystemRelease {
  version     String   @id
  releasedAt  DateTime
  title       String
  changes     Json
  installedAt DateTime @default(now())

  @@map("system_releases")
}

/// Vendedor que recebe os atendimentos. Pode ou não ter login: o vínculo com um usuário (perfil Vendedor)
/// é o que permite o escopo "somente os próprios registros".
/// Unidades da empresa (matriz e filiais). Segmentam atendimentos, vendedores, usuários e relatórios.
model Unit {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  city           String?
  state          String?  @db.Char(2)
  isHeadquarters Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  sellers Seller[]
  users   User[]
  records ServiceRecord[]
  leads   Lead[]

  @@unique([tenantId, name])
  @@map("units")
}

model Seller {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  unitId    String?  @db.Uuid
  email     String?
  phone     String?
  userId    String?  @unique @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  unit    Unit?           @relation(fields: [unitId], references: [id])
  user    User?           @relation(fields: [userId], references: [id])
  records ServiceRecord[]
  leads   Lead[]

  @@unique([tenantId, name])
  @@map("sellers")
}

model LookupItem {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  type      LookupType
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  originOf       ServiceRecord[] @relation("RecordOrigin")
  leadOriginOf   Lead[]          @relation("LeadOrigin")
  customerTypeOf ServiceRecord[] @relation("RecordCustomerType")
  lostReasonOf   ServiceRecord[] @relation("RecordLostReason")

  @@unique([tenantId, type, name])
  @@map("lookup_items")
}

/// Atendimento de Pré-Vendas ou Pós-Vendas.
model ServiceRecord {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  kind           ServiceKind
  leadAt         DateTime
  name           String
  customerCode   String?
  phone          String?
  email          String?
  sellerId       String?       @db.Uuid
  /// Lead da base vinculado (pelo telefone ou e-mail). Liga o atendimento à linha do tempo do lead.
  leadId         String?       @db.Uuid
  /// Unidade do atendimento. Preenchida pela unidade do vendedor quando ele é escolhido (pode ser alterada).
  unitId         String?       @db.Uuid
  originId       String?       @db.Uuid
  customerTypeId String?       @db.Uuid
  country        String        @default("BR")
  state          String?       @db.Char(2)
  city           String?
  /// Marcas da máquina e tipos de peça (ids de LookupItem), seleção múltipla.
  brandIds       String[]      @db.Uuid
  partTypeIds    String[]      @db.Uuid
  forwarded      Boolean       @default(false)
  forwardedAt    DateTime?
  returnStatus   ReturnStatus?
  returnedAt     DateTime?
  saleStatus     SaleStatus    @default(NEGOCIACAO)
  lostReasonId   String?       @db.Uuid
  invoiceNumber  String?
  saleValue      Decimal?      @db.Decimal(12, 2)
  notes          String?
  /// Pós-venda: pré-venda que o originou (criado automaticamente ao fechar a pré-venda).
  parentId       String?       @db.Uuid
  /// Pós-venda: situação do acompanhamento, prazo para o primeiro contato e quando ele aconteceu.
  followStatus   FollowStatus?
  followNote     String?
  dueAt          DateTime?
  firstActionAt  DateTime?
  /// Chave de deduplicação da importação: reimportar a mesma planilha não duplica registros.
  externalKey    String?
  importBatch    String?
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  seller       Seller?                @relation(fields: [sellerId], references: [id])
  lead         Lead?                  @relation(fields: [leadId], references: [id])
  unit         Unit?                  @relation(fields: [unitId], references: [id])
  origin       LookupItem?            @relation("RecordOrigin", fields: [originId], references: [id])
  customerType LookupItem?            @relation("RecordCustomerType", fields: [customerTypeId], references: [id])
  lostReason   LookupItem?            @relation("RecordLostReason", fields: [lostReasonId], references: [id])
  parent       ServiceRecord?         @relation("PostSale", fields: [parentId], references: [id])
  children     ServiceRecord[]        @relation("PostSale")
  history      ServiceRecordHistory[]

  @@unique([tenantId, externalKey])
  @@index([tenantId, kind, leadAt])
  @@index([sellerId])
  @@index([unitId])
  @@index([leadId])
  @@index([phone])
  @@index([parentId])
  @@index([tenantId, kind, followStatus, dueAt])
  @@map("service_records")
}

/// Histórico de alterações de cada atendimento (quem mudou o quê e quando).
model ServiceRecordHistory {
  id        String   @id @default(uuid()) @db.Uuid
  recordId  String   @db.Uuid
  userId    String?  @db.Uuid
  userName  String?
  action    String
  changes   Json
  createdAt DateTime @default(now())

  record ServiceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
  @@map("service_record_history")
}

/// Pessoa identificada (por e-mail e/ou telefone). Deduplicada por e-mail e por telefone (E.164).
model Lead {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  name         String?
  email        String?
  phone        String?
  company      String?
  jobTitle     String?
  country      String    @default("BR")
  state        String?   @db.Char(2)
  city         String?
  stage        LeadStage @default(LEAD)
  ownerId      String?   @db.Uuid
  unitId       String?   @db.Uuid
  originId     String?   @db.Uuid
  /// Etiquetas em minúsculas (ex.: "revenda", "newsletter").
  tags         String[]
  /// Valores dos campos personalizados, por chave do campo.
  customFields Json      @default("{}")

  /// Permissão para receber e-mail marketing (LGPD). Histórico completo em lead_consents.
  emailOptIn   Boolean   @default(false)
  emailOptOutAt DateTime?
  /// E-mail recusado pelo servidor do destinatário (inexistente): fica fora das campanhas até ser corrigido.
  emailBouncedAt DateTime?

  firstConversionAt DateTime?
  lastConversionAt  DateTime?
  /// Origem/UTMs da primeira e da última conversão.
  firstConversion   Json?
  lastConversion    Json?

  lastOpportunityAt DateTime?
  lastSaleAt        DateTime?
  lastSaleValue     Decimal?  @db.Decimal(12, 2)

  scoreProfile   Int       @default(0)
  scoreInterest  Int       @default(0)
  scoreGrade     String?   @db.Char(1)
  scoreUpdatedAt DateTime?
  lastActivityAt DateTime?

  importBatch String?
  /// Id do cliente na loja virtual (Magazord), quando ele tem cadastro lá.
  ecommerceId String?
  /// Dados pessoais apagados a pedido do titular (LGPD): o registro fica só para estatística.
  anonymizedAt DateTime?
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  owner    Seller?         @relation(fields: [ownerId], references: [id])
  unit     Unit?           @relation(fields: [unitId], references: [id])
  origin   LookupItem?     @relation("LeadOrigin", fields: [originId], references: [id])
  events   LeadEvent[]
  consents LeadConsent[]
  records  ServiceRecord[]
  visitors SiteVisitor[]
  carts    EcommerceCart[]
  orders   EcommerceOrder[]
  captures CaptureSubmission[]
  emails   EmailRecipient[]

  @@unique([tenantId, email])
  @@index([tenantId, ecommerceId])
  @@index([tenantId, phone])
  @@index([tenantId, stage])
  @@index([tenantId, scoreGrade])
  @@index([ownerId])
  @@map("leads")
}

/// Navegador que visitou o site (identificado por um número aleatório em cookie do próprio site).
/// Fica anônimo até ser ligado a um lead (link de e-mail, formulário ou integração).
model SiteVisitor {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  clientId     String
  leadId       String?   @db.Uuid
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// Origem da primeira e da última visita (fonte, meio, campanha, página de entrada).
  firstTouch   Json?
  lastTouch    Json?
  sessions     Int       @default(0)
  pageviews    Int       @default(0)
  identifiedAt DateTime?
  /// Dispositivo da primeira e da última visita: celular, tablet, computador ou app (só a categoria, nunca o navegador).
  firstDevice  String?
  device       String?

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  lead   Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  views  SitePageview[]
  events SiteEvent[]

  @@unique([tenantId, clientId])
  @@index([leadId])
  @@index([tenantId, lastSeenAt])
  @@map("site_visitors")
}

model SitePageview {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  visitorId  String   @db.Uuid
  sessionId  String
  /// URL sem parâmetros desconhecidos (só UTMs e afins), para não guardar dado pessoal por acidente.
  url        String
  title      String?
  newSession Boolean  @default(false)
  /// Origem, só na primeira página de cada visita.
  touch      Json?
  device     String?
  occurredAt DateTime @default(now())

  visitor SiteVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("site_pageviews")
}

/// Eventos de compra da loja captados pelo script (adicionou ao carrinho, iniciou checkout, comprou).
model SiteEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  visitorId  String   @db.Uuid
  name       String
  value      Decimal? @db.Decimal(12, 2)
  /// Produtos do evento: código, nome, preço e quantidade.
  items      Json?
  url        String?
  device     String?
  occurredAt DateTime @default(now())

  visitor SiteVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, occurredAt])
  @@index([tenantId, name, occurredAt])
  @@map("site_events")
}

/// Carrinho da loja virtual (Magazord). Aberto, abandonado ou comprado; base para recuperar vendas.
model EcommerceCart {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  externalId     String
  hash           String?
  /// 1 aberto, 2 abandonado, 3 comprado (códigos da Magazord).
  status         Int
  leadId         String?   @db.Uuid
  customerId     String?
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  startedAt      DateTime?
  lastActivityAt DateTime?
  /// Cliente chegou ao checkout (preencheu endereço de entrega).
  checkoutStarted Boolean  @default(false)
  checkoutUrl    String?
  items          Json      @default("[]")
  itemCount      Int       @default(0)
  value          Decimal?  @db.Decimal(12, 2)
  orderCode      String?
  /// Acompanhamento da recuperação pela equipe.
  contactStatus  String    @default("PENDENTE")
  contactNote    String?
  contactedAt    DateTime?
  contactedBy    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalId])
  @@index([tenantId, status, lastActivityAt])
  @@index([leadId])
  @@map("ecommerce_carts")
}

/// Pedido da loja virtual (Magazord). Alimenta a última venda do lead e, depois, a atribuição de receita.
model EcommerceOrder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  externalId  String
  code        String
  leadId      String?  @db.Uuid
  customerId  String?
  orderedAt   DateTime
  total       Decimal  @db.Decimal(12, 2)
  statusCode  Int
  statusName  String
  /// pago (aprovado, faturado, enviado, entregue), pendente ou cancelado.
  statusGroup String
  payment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalId])
  @@index([leadId, orderedAt])
  @@index([tenantId, orderedAt])
  @@map("ecommerce_orders")
}

/// Avisos recebidos de integrações (Meta Lead Ads e, depois, Magazord). A chave única impede processar
/// duas vezes o mesmo aviso quando o serviço reenvia.
model IntegrationReceipt {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  provider   String
  externalId String
  status     String
  leadId     String?  @db.Uuid
  error      String?
  receivedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, provider, receivedAt])
  @@map("integration_receipts")
}

/// Formulário de captura: usado no site (embutido ou em pop-up) e nas landing pages.
model CaptureForm {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  /// Campos: [{ key: "name" | "email" | "phone" | ... | "custom:<chave>" | "message", label, required, options? }]
  fields         Json
  submitLabel    String   @default("Enviar")
  successMessage String   @default("Recebemos seus dados. Em breve entraremos em contato.")
  /// Depois de enviar: abre o WhatsApp central com a mensagem preenchida ou vai para um endereço.
  afterSubmit    String   @default("mensagem")
  redirectUrl    String?
  /// Caixa de consentimento para e-mail marketing (LGPD). Vazio = não mostra.
  consentText    String?
  originName     String   @default("Site - LP")
  ownerId        String?  @db.Uuid
  /// Opcionais: tipo de cliente e marcas da máquina gravados no atendimento (rastreiam de qual LP/site veio).
  customerTypeId String?  @db.Uuid
  brandIds       String[] @default([]) @db.Uuid
  tags           String[]
  /// Também cria um atendimento na fila de Pré-Vendas.
  createRecord   Boolean  @default(true)
  active         Boolean  @default(true)
  submissions    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  popups CapturePopup[]
  sends  CaptureSubmission[]

  @@index([tenantId])
  @@map("capture_forms")
}

/// Pop-up exibido no site pelo script do CRM, com um formulário.
model CapturePopup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  formId    String   @db.Uuid
  title     String
  text      String?
  imageUrl  String?
  /// Quando abre: tempo na página, intenção de saída ou rolagem.
  trigger   String   @default("delay")
  delaySec  Int      @default(10)
  scrollPct Int      @default(50)
  /// Páginas onde aparece (trechos do endereço). Vazio = todas.
  include   String[]
  exclude   String[]
  device    String   @default("todos")
  /// Depois de fechado ou enviado, não aparece de novo por N dias para o mesmo visitante.
  frequencyDays Int  @default(7)
  color     String   @default("#1d4ed8")
  /// Opcionais: substituem os do formulário (vazio = usa o do formulário).
  ownerId        String?  @db.Uuid
  customerTypeId String?  @db.Uuid
  brandIds       String[] @default([]) @db.Uuid
  active    Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  form   CaptureForm @relation(fields: [formId], references: [id])

  @@index([tenantId])
  @@map("capture_popups")
}

/// Botão flutuante de WhatsApp. Pode haver vários (ex.: um nas LPs de revenda, outro na loja); em cada página
/// aparece o primeiro ativo cujas regras de página e dispositivo combinam.
model CaptureWhatsapp {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  /// E.164. Não vai para o site: o link só é entregue depois do cadastro.
  phone          String
  buttonText     String   @default("Fale no WhatsApp")
  title          String   @default("Fale com a gente")
  subtitle       String   @default("")
  askEmail       Boolean  @default(false)
  message        String
  position       String   @default("direita")
  color          String   @default("#25D366")
  include        String[]
  exclude        String[]
  device         String   @default("todos")
  ownerId        String?  @db.Uuid
  customerTypeId String?  @db.Uuid
  brandIds       String[] @default([]) @db.Uuid
  tags           String[]
  createRecord   Boolean  @default(true)
  active         Boolean  @default(false)
  /// Ordem de prioridade quando mais de um botão serve para a mesma página (menor primeiro).
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("capture_whatsapps")
}

/// Segmento de leads para campanhas (e, na Fase 6, automações): filtros da base de leads salvos com um nome.
model EmailSegment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  /// Mesmos filtros da base de leads (estágio, nota, tags, estado, responsável, unidade, origem, datas).
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  campaigns EmailCampaign[]

  @@index([tenantId])
  @@map("email_segments")
}

enum CampaignStatus {
  RASCUNHO
  AGENDADA
  ENVIANDO
  PAUSADA
  ENVIADA
  CANCELADA
}

/// Campanha de e-mail marketing: conteúdo em blocos, público (segmento) e andamento do envio.
model EmailCampaign {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  subject     String
  preheader   String?
  fromName    String?
  replyTo     String?
  /// Blocos do editor (título, texto, imagem, botão, produtos...).
  blocks      Json           @default("[]")
  /// Links do conteúdo no momento do envio (o clique rastreado aponta para o índice, nunca para um endereço livre).
  links       String[]
  segmentId   String?        @db.Uuid
  status      CampaignStatus @default(RASCUNHO)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  total       Int            @default(0)
  sent        Int            @default(0)
  failed      Int            @default(0)
  opens       Int            @default(0)
  clicks      Int            @default(0)
  unsubscribes Int           @default(0)
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  segment    EmailSegment?    @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients EmailRecipient[]

  @@index([tenantId, status])
  @@map("email_campaigns")
}

/// Um destinatário de uma campanha: envio, abertura, cliques e descadastro.
model EmailRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  campaignId     String    @db.Uuid
  leadId         String    @db.Uuid
  email          String
  /// PENDENTE, ENVIADO, ERRO
  status         String    @default("PENDENTE")
  error          String?
  sentAt         DateTime?
  openedAt       DateTime?
  opens          Int       @default(0)
  clickedAt      DateTime?
  clicks         Int       @default(0)
  unsubscribedAt DateTime?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  clicksLog EmailClick[]

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
  @@map("email_recipients")
}

/// Clique em um link da campanha (para o relatório de links mais clicados).
model EmailClick {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @db.Uuid
  campaignId  String   @db.Uuid
  linkIndex   Int
  createdAt   DateTime @default(now())

  recipient EmailRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId, linkIndex])
  @@map("email_clicks")
}

/// Cada envio de formulário, pop-up ou botão de WhatsApp (prova da conversão e do consentimento).
model CaptureSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  /// formulario, popup, whatsapp, landing
  channel   String
  formId    String?  @db.Uuid
  popupId   String?  @db.Uuid
  whatsappId String? @db.Uuid
  leadId    String?  @db.Uuid
  recordId  String?  @db.Uuid
  data      Json
  pageUrl   String?
  touch     Json?
  device    String?
  createdAt DateTime @default(now())

  form CaptureForm? @relation(fields: [formId], references: [id], onDelete: SetNull)
  lead Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([formId, createdAt])
  @@index([leadId])
  @@map("capture_submissions")
}

/// Linha do tempo do lead: conversões, mudanças, vendas, e-mails (próximas fases), importações.
model LeadEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  leadId     String   @db.Uuid
  type       String
  title      String
  data       Json?
  occurredAt DateTime @default(now())
  userId     String?  @db.Uuid
  userName   String?
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@map("lead_events")
}

/// Registro de consentimento (LGPD): o que foi aceito, quando, de onde e com qual texto.
model LeadConsent {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  purpose   String
  granted   Boolean
  source    String
  text      String?
  ip        String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, purpose, createdAt])
  @@map("lead_consents")
}

model CustomFieldDef {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  key       String
  label     String
  type      CustomFieldType
  options   String[]
  active    Boolean         @default(true)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("custom_field_defs")
}

/// Regra de lead scoring. Perfil: atributos do lead. Interesse: eventos recentes.
model ScoreRule {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  dimension ScoreDimension
  name      String
  /// Perfil: "stage", "state", "tag", "customer_type", "has_phone", "custom:<chave>". Interesse: tipo de evento.
  field     String
  operator  String
  value     Json?
  points    Int
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, dimension])
  @@map("score_rules")
}

/// Importação de planilha de leads (arquivo, mapeamento de colunas, andamento e relatório).
model LeadImport {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  fileName    String
  filePath    String?
  status      String    @default("ENVIADO")
  headers     String[]
  totalRows   Int       @default(0)
  mapping     Json?
  options     Json?
  report      Json?
  processed   Int       @default(0)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("lead_imports")
}

