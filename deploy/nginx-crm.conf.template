# Vhost EXCLUSIVO do CRM (arquivo /etc/nginx/sites-available/usaparts-crm).
# Não altera nenhum outro site. O certbot adiciona o bloco HTTPS e o redirecionamento depois.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__;

    server_tokens off;
    client_max_body_size 2m;

    access_log /var/log/nginx/usaparts-crm.access.log;
    error_log  /var/log/nginx/usaparts-crm.error.log;

    location / {
        proxy_pass http://127.0.0.1:__PORTA__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}
